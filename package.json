{
  "name": "smarthome-security-backend",
  "version": "1.1.0",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "demo": "node src/demo.js",
    "seed": "node scripts/seed.js",
    "lint": "node scripts/lint.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:e2e": "jest --runInBand tests/e2e",
    "test:fuzz": "jest --runInBand tests/fuzz",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "setupFiles": ["<rootDir>/tests/setupEnv.js"]
  }
}
