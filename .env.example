# Used by docker-compose.yml. Copy to ".env" (never commit it) and replace every value.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_USER=smarthome_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Optional: initial passwords for `seed` (random ones are printed when empty)
SEED_ADMIN_PASSWORD=
SEED_HOMEOWNER_PASSWORD=
