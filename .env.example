# Local (non-Docker) configuration. Copy to backend/.env - never commit it.
PORT=3000
NODE_ENV=development
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smarthome
DB_USER=smarthome_app
DB_PASSWORD=CHANGE_ME
# Optional
# TRUST_PROXY=false
# CORS_ORIGIN=
# LOGIN_RATE_MAX=10
# RATE_LIMIT_MAX=200
# COMMAND_WINDOW_MS=120000
